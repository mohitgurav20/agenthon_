# ===== AGENT ZERO — Person A Environment Variables =====
# Copy to .env and fill in your keys. Never commit .env to git.

# --- Google Gemini (Deep Reasoning + Flash) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Groq (Ultra-Fast Routing, 800 tok/sec) ---
GROQ_API_KEY=your_groq_api_key

# --- Langfuse (Observability — Secret Weapon) ---
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Service URLs ---
TOOLS_API_URL=http://localhost:3000
MEMORY_API_URL=http://localhost:3001
ORCHESTRATOR_PORT=3002

# --- Node ---
NODE_ENV=development
