# ===== AGENT ZERO — Environment Variables (Merged) =====
# Copy to .env and fill in your keys. Never commit .env to git.

# --- Node / Environment ---
NODE_ENV=development
ORCHESTRATOR_PORT=3002
PORT=3000

# --- Google Gemini (Deep Reasoning + Flash) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Groq (Ultra-Fast Routing, 800 tok/sec) ---
GROQ_API_KEY=your_groq_api_key

# --- Langfuse (Observability — Secret Weapon) ---
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Service URLs ---
TOOLS_API_URL=http://localhost:3000
MEMORY_API_URL=http://localhost:3001

# --- Tavily (Web Search) ---
TAVILY_API_KEY=your_tavily_key

# --- n8n (Automation) ---
N8N_BASE_URL=your_n8n_webhook_url
N8N_API_KEY=your_n8n_api_key

# --- ElevenLabs (Voice / TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id

# --- Bland AI (Phone Calls) ---
BLAND_API_KEY=your_bland_api_key

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Supabase (Database) ---
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# --- Trigger.dev (Background Jobs) ---
TRIGGER_SECRET_KEY=your_trigger_secret_key
TRIGGER_PROJECT_ID=your_trigger_project_id

# --- Skyvern (Form Filling) ---
SKYVERN_API_KEY=your_skyvern_api_key

# --- Email (Gmail via Nodemailer) ---
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

