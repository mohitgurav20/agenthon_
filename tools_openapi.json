{
  "openapi": "3.0.0",
  "info": {
    "title": "Agent Zero - Person B Tools API",
    "version": "1.0.0",
    "description": "REST API exposing all 10 agent tools for the Orchestrator."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "paths": {
    "/tools/search": {
      "post": {
        "summary": "Tavily Web Search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "maxResults": { "type": "integer", "default": 5 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Search Results" } }
      }
    },
    "/tools/scrape": {
      "post": {
        "summary": "Browser-Use Web Scraper",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": { "type": "string" },
                  "task": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Scraped Content" } }
      }
    },
    "/tools/email": {
      "post": {
        "summary": "Send Email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": { "type": "string" },
                  "subject": { "type": "string" },
                  "body": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Email Status" } }
      }
    },
    "/tools/whatsapp": {
      "post": {
        "summary": "Send WhatsApp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": { "type": "string" },
                  "message": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "WhatsApp Status" } }
      }
    },
    "/tools/analyze-data": {
      "post": {
        "summary": "Supabase Data Analytics",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "table": { "type": "string" },
                  "analysisType": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Analytics Result" } }
      }
    }
  }
}
