{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_URL": "<YOUR_SUPABASE_URL>",
        "SUPABASE_SERVICE_ROLE_KEY": "<YOUR_SUPABASE_SERVICE_ROLE_KEY>"
      }
    },
    "mem0": {
      "command": "uvx",
      "args": [
        "mem0-mcp-server"
      ],
      "env": {
        "MEM0_API_KEY": "<YOUR_MEM0_API_KEY>",
        "MEM0_DEFAULT_USER_ID": "agent-zero-user"
      }
    }
  }
}
